<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>512ce96a-36b4-42fb-aabc-830314848c65</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
        <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
        <PackageReference Include="Aspire.Hosting.Javascript" Version="17.0.0" />
        <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
        <PackageReference Include="Aspire.Hosting.Valkey" Version="17.0.0" />
        <!-- GHSA-qhrr-8q5h-9q3h: Aspire.Hosting 13.6.1 still pulls 2.5.302 through StreamJsonRpc -->
        <PackageReference Include="MessagePack" Version="2.5.307" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    </ItemGroup>
</Project>
